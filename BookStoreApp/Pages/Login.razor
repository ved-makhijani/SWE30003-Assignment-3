@page "/login"
@inject BookstoreApp.Data.Database Db
@inject BookstoreApp.Services.SessionService Session
@inject NavigationManager Nav

<PageTitle>Login — Favourite Books</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Login</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="msg-error">@errorMessage</div>
        }

        @if (loginSuccess)
        {
            <div class="msg-success">Welcome back, @Session.Name! Redirecting...</div>
        }

        <div class="form-group">
            <label>Email</label>
            <input class="input" type="email" @bind="email"
                   placeholder="you@example.com"
                   @onkeyup="HandleKey" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input class="input" type="password" @bind="password"
                   placeholder="Your password"
                   @onkeyup="HandleKey" />
        </div>

        <button class="btn btn-primary btn-full" @onclick="DoLogin">Login</button>

        <p class="auth-link">Don't have an account? <a href="/register">Register here</a></p>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool loginSuccess = false;

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    private async Task DoLogin()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Email and password are required.";
            return;
        }

        var user = Db.GetUserByCredentials(email.Trim(), password.Trim());
        if (user == null)
        {
            errorMessage = Db.EmailExists(email.Trim())
                ? "Incorrect password. Please try again."
                : "Email not registered. Please register first.";
            return;
        }

        Session.Login(user.Value.Email, user.Value.Name, user.Value.Role, user.Value.Address);
        Session.NotifyStateChanged();
        loginSuccess = true;
        StateHasChanged();

        await Task.Delay(300);
        Nav.NavigateTo(Session.IsAdmin ? "/admin" : "/catalogue");
    }
}
