@page "/login"
@inject Database Db
@inject SessionService Session
@inject NavigationManager Nav

<PageTitle>Login — Favourite Books</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Login</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="msg-error">@errorMessage</div>
        }

        <div class="form-group">
            <label>Email</label>
            <input class="input" type="email" @bind="email" placeholder="you@example.com" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input class="input" type="password" @bind="password" placeholder="Your password" />
        </div>

        <button class="btn btn-primary btn-full" @onclick="DoLogin">Login</button>

        <p class="auth-link">Don't have an account? <a href="/register">Register here</a></p>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";

    private void DoLogin()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Email and password are required.";
            return;
        }

        var user = Db.GetUserByCredentials(email, password);
        if (user == null)
        {
            errorMessage = Db.EmailExists(email)
                ? "Incorrect password. Please try again."
                : "Email not registered. Please register first.";
            return;
        }

        Session.Login(user.Value.Email, user.Value.Name, user.Value.Role, user.Value.Address);
        Session.NotifyStateChanged();

        Nav.NavigateTo(Session.IsAdmin ? "/admin" : "/catalogue");
    }
}
